{
  "name": "screek-screenshots",
  "version": "1.0.0",
  "description": "Script de screenshots automáticos de todas as telas do screeK",
  "type": "module",
  "scripts": {
    "setup": "npm install && npx playwright install chromium",
    "login:user": "node shoot.mjs login user",
    "login:manager": "node shoot.mjs login manager",
    "shoot": "node shoot.mjs",
    "shoot:dark": "node shoot.mjs --dark",
    "shoot:desktop": "node shoot.mjs --desktop",
    "shoot:mobile": "node shoot.mjs --mobile"
  },
  "devDependencies": {
    "playwright": "^1.49.0"
  }
}
