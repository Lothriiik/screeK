# Configuração local do serviço de recomendação.
# Copie para `.env` e preencha os valores. NUNCA commite o `.env`.

# --- API ---
APP_NAME=screeK Intelligence Service
APP_VERSION=0.1.0
DEBUG=true
HOST=0.0.0.0
PORT=8081
API_PREFIX=/api/v1

# Origens do frontend (JSON array ou lista separada por vírgula).
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# --- Fonte de dados do recomendador ---
# "postgres" = produção (tabelas canônicas do Go, read-only).
# "csv"      = desenvolvimento/testes com o export normalizado offline.
DATA_SOURCE=csv
# DATABASE_URL=postgres://postgres:password@localhost:5432/screek?sslmode=disable
DB_CONNECT_TIMEOUT_SECONDS=10

# --- TMDB (apenas tools/ de bootstrap) ---
# Token de leitura (v4) do TMDB. Sem ele, apenas o cache local funciona.
TMDB_TOKEN=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_LANGUAGE=en-US
TMDB_REQUEST_DELAY=0.12
TMDB_CACHE_TTL_DAYS=30
TMDB_TIMEOUT_SECONDS=20

# --- Dados (bootstrap) ---
# DATA_DIR=./data

# --- Escala de notas (Letterboxd) ---
RATING_MIN=0.5
RATING_MAX=5.0
RATING_UNRATED=0.0

# --- Matching Letterboxd -> TMDB (apenas tools/) ---
MATCH_MIN_SCORE=70
MATCH_LANGUAGE=en-US
MATCH_YEAR_TOLERANCE=2

# --- Recomendação ---
DEFAULT_RECOMMENDATION_LIMIT=20
DEFAULT_USER_ID=local
